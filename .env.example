# Zero-Friction Public X Launch (OpenRouter Hosted Mode — Recommended):
# Set OPENROUTER_API_KEY on Vercel (and locally in .env.local) so visitors
# can snap their desk and chat immediately without needing their own API key.
OPENROUTER_API_KEY=

# Fast & ultra-low-cost Gemini multimodal models on OpenRouter
OPENROUTER_VISION_MODEL=google/gemini-3.1-flash-lite
OPENROUTER_CHAT_MODEL=google/gemini-2.5-flash-lite

# Canonical public URL used for OpenGraph / X summary_large_image metadata
NEXT_PUBLIC_SITE_URL=https://desktea.vercel.app

# Hourly per-IP rate limits protecting your hosted OpenRouter budget
DESKTEA_VISION_LIMIT_PER_HOUR=12
DESKTEA_CHAT_LIMIT_PER_HOUR=40

# Optional Google Gemini direct key or provider override (agy | gemini)
# GEMINI_API_KEY=
# DESKTEA_PROVIDER=agy
